DEPLOYER_PRIVATE_KEY=<insert deployer's private key here>

# See available forwarders on https://docs.opengsn.org/networks/ethereum/goerli.html
FORWARDER_ADDRESS=0xB2b5841DBeF766d4b521221732F9B618fCf34A87

# List of addresses to get the different roles
MINTER_BURNER_ROLE=0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000001
DISALLOW_ROLE=0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000001
CIRCUIT_BREAKER_ROLE=0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000001

# Alchemy API Key
ALCHEMY_KEY=<insert alchemy api key here>

RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/$ALCHEMY_KEY
# ---------------------------------------------------------------------------
# CREATE2 deployments (deploy_twin_token_create2.sh / predict_twin_token_create2.sh)
# CREATE2_SALT, TOKEN_NAMES, TOKEN_SYMBOLS and DEPLOYER_PRIVATE_KEY must be identical on every chain,
# otherwise addresses will differ. The forwarder is hardcoded to address(0) in the script.
# ---------------------------------------------------------------------------
CREATE2_SALT=twin.v1
# Comma separated, same order in both lists
TOKEN_NAMES="Argentine Peso token,Brazilian Real token"
TOKEN_SYMBOLS="ARGt,BRAt"
# Can differ per chain (not part of the addresses)
DEFAULT_ADMIN_ROLE=0x0000000000000000000000000000000000000000
BEACON_OWNER=0x0000000000000000000000000000000000000000
# Comma separated list of RPCs to iterate
RPC_URLS="https://arb-mainnet.g.alchemy.com/v2/$ALCHEMY_KEY,https://base-mainnet.g.alchemy.com/v2/$ALCHEMY_KEY"
ETHERSCAN_API_KEY=<insert etherscan api key here>
